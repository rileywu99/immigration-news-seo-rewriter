# Anthropic API key — https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-...

# Firecrawl API key — https://firecrawl.dev/
FIRECRAWL_API_KEY=fc-...

# Google Sheets ID (the part between /d/ and /edit in the URL)
GOOGLE_SHEETS_ID=1slKGNB9kHfTdyJk1Q29zdP0XbEIAOcNv3M3h1Oef5Gk

# --- Google Auth (pick ONE of the three options below) ---

# Option A: Personal Gmail via OAuth — no extra file needed for local dev.
#   First run opens a browser to authorize. Leave the two vars below blank.
#   Download OAuth credentials from Google Cloud Console → APIs & Services →
#   Credentials → Create OAuth 2.0 Client ID (Desktop app) → save as
#   ~/.config/gspread/credentials.json

# Option B: Service Account JSON file (local)
# GOOGLE_SERVICE_ACCOUNT_JSON=credentials.json

# Option C: Service Account JSON as a single-line string (GitHub Actions CI)
# GOOGLE_CREDENTIALS_JSON_STRING={"type":"service_account","project_id":"..."}

# How many articles to process per run (default: 5)
MAX_ARTICLES=5
